git:
  diffRenderers:
    - command: delta --dark --paging=never
gui:
  nerdFontsVersion: "3"
  theme:
    activeBorderColor:
      - "{{ .darkstar.foreground }}"
      - bold
    inactiveBorderColor:
      - "{{ .darkstar.linenr }}"
    selectedLineFgColor:
      - default
    selectedLineBgColor:
      - "{{ .darkstar.cursorline }}"
    inactiveViewSelectedLineBgColor:
      - "{{ .darkstar.background_two }}"
