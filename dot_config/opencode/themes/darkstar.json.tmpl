{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "blue",
      "purple",
      "green",
      "orange",
      "red",
      "yellow",
      "cyan"
    ],
    "text": {
      "base": "{{ .darkstar.foreground }}",
      "muted": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.200"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.400",
        "$focused": "$hue.interactive.400",
        "$pressed": "$hue.interactive.400",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.400"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.400"
        },
        "warning": {
          "base": "$hue.yellow.400"
        },
        "success": {
          "base": "$hue.green.400"
        },
        "info": {
          "base": "$hue.blue.400"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.600",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.400"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "{{ .darkstar.very_dark }}"
    },
    "scrollbar": {
      "base": "{{ .darkstar.linenr }}"
    },
    "diff": {
      "text": {
        "added": "{{ .darkstar.bright_green }}",
        "removed": "{{ .darkstar.bright_red }}",
        "context": "{{ .darkstar.bright_black }}",
        "hunkHeader": "{{ .darkstar.bright_black }}"
      },
      "background": {
        "added": "{{ template "mix" (list .darkstar.green .darkstar.background 0.82) }}",
        "removed": "{{ template "mix" (list .darkstar.red .darkstar.background 0.82) }}",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "{{ .darkstar.bright_green }}",
        "removed": "{{ .darkstar.bright_red }}"
      },
      "lineNumber": {
        "text": "{{ .darkstar.linenr }}",
        "background": {
          "added": "{{ template "mix" (list .darkstar.green .darkstar.background 0.88) }}",
          "removed": "{{ template "mix" (list .darkstar.red .darkstar.background 0.88) }}"
        }
      }
    },
    "syntax": {
      "comment": "{{ .darkstar.black }}",
      "keyword": "{{ .darkstar.bright_red }}",
      "function": "{{ .darkstar.bright_yellow }}",
      "variable": "{{ .darkstar.foreground }}",
      "string": "{{ .darkstar.bright_green }}",
      "number": "{{ .darkstar.bright_blue }}",
      "type": "{{ .darkstar.bright_blue }}",
      "operator": "{{ .darkstar.foreground }}",
      "punctuation": "{{ .darkstar.foreground }}"
    },
    "markdown": {
      "text": "{{ .darkstar.foreground }}",
      "heading": "{{ .darkstar.bright_green }}",
      "link": "{{ .darkstar.bright_blue }}",
      "linkText": "{{ .darkstar.bright_yellow }}",
      "code": "{{ .darkstar.bright_cyan }}",
      "blockQuote": "{{ .darkstar.bright_green }}",
      "emphasis": "{{ .darkstar.bright_yellow }}",
      "strong": "{{ .darkstar.bright_yellow }}",
      "horizontalRule": "{{ .darkstar.black }}",
      "listItem": "{{ .darkstar.bright_red }}",
      "listEnumeration": "{{ .darkstar.bright_red }}",
      "image": "{{ .darkstar.bright_blue }}",
      "imageText": "{{ .darkstar.bright_yellow }}",
      "codeBlock": "{{ .darkstar.foreground }}"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.max"
          },
          "secondary": {
            "$hovered": "$background.raised.max"
          }
        }
      },
      "@footer": {
        "text": {
          "muted": "$hue.neutral.200"
        }
      }
    }
  },
  "dark": {
    "hue": {
      "red": {
        "100": "{{ template "mix" (list .darkstar.bright_red "#ffffff" 0.6) }}",
        "200": "{{ template "mix" (list .darkstar.bright_red "#ffffff" 0.3) }}",
        "300": "{{ template "mix" (list .darkstar.bright_red "#ffffff" 0.12) }}",
        "400": "{{ .darkstar.bright_red }}",
        "500": "{{ .darkstar.red }}",
        "600": "{{ template "mix" (list .darkstar.red .darkstar.background 0.6) }}",
        "700": "{{ template "mix" (list .darkstar.red .darkstar.background 0.78) }}",
        "800": "{{ template "mix" (list .darkstar.red .darkstar.background 0.88) }}",
        "900": "{{ template "mix" (list .darkstar.red .darkstar.background 0.95) }}"
      },
      "orange": {
        "100": "{{ template "mix" (list .darkstar.bright_orange "#ffffff" 0.6) }}",
        "200": "{{ template "mix" (list .darkstar.bright_orange "#ffffff" 0.3) }}",
        "300": "{{ template "mix" (list .darkstar.bright_orange "#ffffff" 0.12) }}",
        "400": "{{ .darkstar.bright_orange }}",
        "500": "{{ .darkstar.orange }}",
        "600": "{{ template "mix" (list .darkstar.orange .darkstar.background 0.6) }}",
        "700": "{{ template "mix" (list .darkstar.orange .darkstar.background 0.78) }}",
        "800": "{{ template "mix" (list .darkstar.orange .darkstar.background 0.88) }}",
        "900": "{{ template "mix" (list .darkstar.orange .darkstar.background 0.95) }}"
      },
      "yellow": {
        "100": "{{ template "mix" (list .darkstar.bright_yellow "#ffffff" 0.6) }}",
        "200": "{{ template "mix" (list .darkstar.bright_yellow "#ffffff" 0.3) }}",
        "300": "{{ template "mix" (list .darkstar.bright_yellow "#ffffff" 0.12) }}",
        "400": "{{ .darkstar.bright_yellow }}",
        "500": "{{ .darkstar.yellow }}",
        "600": "{{ template "mix" (list .darkstar.yellow .darkstar.background 0.6) }}",
        "700": "{{ template "mix" (list .darkstar.yellow .darkstar.background 0.78) }}",
        "800": "{{ template "mix" (list .darkstar.yellow .darkstar.background 0.88) }}",
        "900": "{{ template "mix" (list .darkstar.yellow .darkstar.background 0.95) }}"
      },
      "green": {
        "100": "{{ template "mix" (list .darkstar.bright_green "#ffffff" 0.6) }}",
        "200": "{{ template "mix" (list .darkstar.bright_green "#ffffff" 0.3) }}",
        "300": "{{ template "mix" (list .darkstar.bright_green "#ffffff" 0.12) }}",
        "400": "{{ .darkstar.bright_green }}",
        "500": "{{ .darkstar.green }}",
        "600": "{{ template "mix" (list .darkstar.green .darkstar.background 0.6) }}",
        "700": "{{ template "mix" (list .darkstar.green .darkstar.background 0.78) }}",
        "800": "{{ template "mix" (list .darkstar.green .darkstar.background 0.88) }}",
        "900": "{{ template "mix" (list .darkstar.green .darkstar.background 0.95) }}"
      },
      "cyan": {
        "100": "{{ template "mix" (list .darkstar.bright_cyan "#ffffff" 0.6) }}",
        "200": "{{ template "mix" (list .darkstar.bright_cyan "#ffffff" 0.3) }}",
        "300": "{{ template "mix" (list .darkstar.bright_cyan "#ffffff" 0.12) }}",
        "400": "{{ .darkstar.bright_cyan }}",
        "500": "{{ .darkstar.cyan }}",
        "600": "{{ template "mix" (list .darkstar.cyan .darkstar.background 0.6) }}",
        "700": "{{ template "mix" (list .darkstar.cyan .darkstar.background 0.78) }}",
        "800": "{{ template "mix" (list .darkstar.cyan .darkstar.background 0.88) }}",
        "900": "{{ template "mix" (list .darkstar.cyan .darkstar.background 0.95) }}"
      },
      "blue": {
        "100": "{{ template "mix" (list .darkstar.bright_blue "#ffffff" 0.6) }}",
        "200": "{{ template "mix" (list .darkstar.bright_blue "#ffffff" 0.3) }}",
        "300": "{{ template "mix" (list .darkstar.bright_blue "#ffffff" 0.12) }}",
        "400": "{{ .darkstar.bright_blue }}",
        "500": "{{ .darkstar.blue }}",
        "600": "{{ template "mix" (list .darkstar.blue .darkstar.background 0.6) }}",
        "700": "{{ template "mix" (list .darkstar.blue .darkstar.background 0.78) }}",
        "800": "{{ template "mix" (list .darkstar.blue .darkstar.background 0.88) }}",
        "900": "{{ template "mix" (list .darkstar.blue .darkstar.background 0.95) }}"
      },
      "purple": {
        "100": "{{ template "mix" (list .darkstar.bright_magenta "#ffffff" 0.6) }}",
        "200": "{{ template "mix" (list .darkstar.bright_magenta "#ffffff" 0.3) }}",
        "300": "{{ template "mix" (list .darkstar.bright_magenta "#ffffff" 0.12) }}",
        "400": "{{ .darkstar.bright_magenta }}",
        "500": "{{ .darkstar.magenta }}",
        "600": "{{ template "mix" (list .darkstar.magenta .darkstar.background 0.6) }}",
        "700": "{{ template "mix" (list .darkstar.magenta .darkstar.background 0.78) }}",
        "800": "{{ template "mix" (list .darkstar.magenta .darkstar.background 0.88) }}",
        "900": "{{ template "mix" (list .darkstar.magenta .darkstar.background 0.95) }}"
      },
      "gray": {
        "100": "{{ .darkstar.bright_white }}",
        "200": "{{ .darkstar.foreground }}",
        "300": "{{ .darkstar.bright_black }}",
        "400": "{{ .darkstar.linenr }}",
        "500": "{{ .darkstar.selection_primary }}",
        "600": "{{ .darkstar.surface }}",
        "700": "{{ .darkstar.background_two }}",
        "800": "{{ .darkstar.surface_low }}",
        "900": "{{ .darkstar.background }}"
      },
      "accent": "$hue.blue",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    }
  }
}
