[alias]
	g   = grep -n
	gi  = grep -ni
	fzf = "!git log --oneline --color=always --decorate=short $@ | \
			fzf --ansi --reverse --no-sort \
				--preview 'git show --color=always {1}' \
				--preview-window '<50(down)' \
				--bind 'enter:become(git show {1})' #"

[core]
	autocrlf = false
	editor = hx
	whitespace = trailing-space,space-before-tab
	logallrefupdates = true
	quotePath = false
	commitGraph = true

[diff]
	algorithm = histogram
	colorMoved = default
	colorMovedWS = allow-indentation-change

[fetch]
	writeCommitGraph = true
	prune = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[gc]
	reflogexpire = 90
	writeCommitGraph = true

[gpg]
	format = openpgp

[init]
	defaultBranch = main

[log]
	date = iso

[push]
	autoSetupRemote = true

[receive]
	advertisePushOptions = true
	procReceiveRefs = refs/for
	hideRefs = refs/pull/

[safe]
	directory = *

[uploadpack]
	allowfilter = true
	allowAnySHA1InWant = true

[user]
	name = Henry Catalini Smith
	email = henry@catalinismith.se
[checkout]
	defaultRemote = origin
[pull]
	rebase = true
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[rebase]
	updateRefs = true
	autoSquash = true
	autoStash = true
[rerere]
	enabled = true
	autoUpdate = true
[merge]
	conflictstyle = zdiff3
[commit]
	verbose = true
