{{- $d := .darkstar -}}
[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true
	syntax-theme = darkstar
	line-numbers = true

	minus-style = syntax "{{ template "mix" (list $d.red $d.background 0.82) }}"
	minus-emph-style = syntax "{{ template "mix" (list $d.red $d.background 0.6) }}"
	minus-empty-line-marker-style = normal "{{ template "mix" (list $d.red $d.background 0.82) }}"
	plus-style = syntax "{{ template "mix" (list $d.green $d.background 0.82) }}"
	plus-emph-style = syntax "{{ template "mix" (list $d.green $d.background 0.6) }}"
	plus-empty-line-marker-style = normal "{{ template "mix" (list $d.green $d.background 0.82) }}"
	whitespace-error-style = "{{ $d.background }}" "{{ $d.bright_red }}"

	line-numbers-minus-style = "{{ $d.bright_red }}"
	line-numbers-plus-style = "{{ $d.bright_green }}"
	line-numbers-zero-style = "{{ $d.linenr }}"
	line-numbers-left-style = "{{ $d.very_dark }}"
	line-numbers-right-style = "{{ $d.very_dark }}"

	file-style = "{{ $d.bright_yellow }}" bold
	file-decoration-style = "{{ $d.very_dark }}" ul
	hunk-header-style = file line-number syntax
	hunk-header-file-style = "{{ $d.bright_blue }}"
	hunk-header-line-number-style = "{{ $d.bright_black }}"
	hunk-header-decoration-style = "{{ $d.very_dark }}" box
	commit-style = "{{ $d.bright_yellow }}"
	commit-decoration-style = "{{ $d.very_dark }}" box
	blame-palette = "{{ $d.background }}" "{{ $d.background_two }}" "{{ $d.cursorline }}"
